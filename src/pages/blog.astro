---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import BlogArticleCard from '../components/ui/BlogArticleCard.astro';
import Button from '../components/ui/Button.astro';
import { blogIntro, blogCategories, blogPosts } from '../data/blog';
---

<BaseLayout
  title="Blog | Reflexiones sobre la Arquitectura de los Vínculos"
  description="Territorio de indagación sobre la trama oculta de nuestras relaciones. Artículos de Florencia Villeneuve sobre la pareja, la crianza y la matriz de nuestros vínculos."
  keywords="blog vínculos, psicología de pareja, polaridades en la pareja, crianza consciente, dinámica familiar, reciprocidad y amistad, psicología jungiana, Florencia Villeneuve"
  canonical="/blog"
>
  <Header />
  <main class="pt-24 min-h-screen flex flex-col justify-between">
    <!-- Hero con Introducción de la Sección -->
    <section class="section-padding bg-deep border-b border-gold/15">
      <div class="container-padding max-w-4xl mx-auto text-center">
        <span class="inline-block px-4 py-1.5 bg-gold/10 text-gold text-xs sm:text-sm font-body uppercase tracking-widest rounded-full mb-6 border border-gold/30">
          {blogIntro.badge}
        </span>
        <h1 class="font-display text-4xl sm:text-6xl lg:text-7xl text-gold font-light mb-8 tracking-wide leading-tight">
          {blogIntro.heading}
        </h1>
        <div class="space-y-5 max-w-3xl mx-auto text-parchment/90 font-body font-light text-lg sm:text-xl lg:text-2xl leading-relaxed text-justify sm:text-center">
          <p>{blogIntro.description}</p>
          <p class="text-parchment/80 text-base sm:text-lg lg:text-xl leading-relaxed">{blogIntro.secondaryDescription}</p>
        </div>

        <!-- Selector de Categorías (Navegación Rápida) -->
        <nav aria-label="Categorías del Blog" class="mt-12 pt-8 border-t border-gold/20 flex flex-wrap items-center justify-center gap-4">
          {blogCategories.map((cat) => (
            <a
              href={cat.anchor}
              class="px-6 py-3 rounded-full text-sm sm:text-base font-body tracking-wider uppercase bg-night/80 border border-gold/30 text-parchment hover:border-gold hover:text-gold hover:bg-gold/10 transition-all duration-300"
            >
              {cat.label}
            </a>
          ))}
        </nav>
      </div>
    </section>

    <!-- Artículos Agrupados por Categoría -->
    <div class="bg-night flex-1 py-16">
      <div class="container-padding max-w-4xl mx-auto space-y-20">
        {blogCategories.map((category) => {
          const categoryPosts = blogPosts.filter((p) => p.category === category.id);
          return (
            <section id={category.id} class="scroll-mt-28">
              <!-- Encabezado de la Categoría -->
              <div class="mb-10 pb-4 border-b border-gold/30 flex flex-col md:flex-row md:items-end justify-between gap-4">
                <div>
                  <h2 class="font-display text-4xl sm:text-5xl text-gold font-light tracking-wide">
                    {category.label}
                  </h2>
                </div>
                <p class="font-body font-light text-parchment/80 text-base sm:text-lg max-w-lg leading-relaxed">
                  {category.description}
                </p>
              </div>

              <!-- Listado de Artículos de la Subsección -->
              <div class="space-y-12">
                {categoryPosts.map((post) => (
                  <BlogArticleCard post={post} />
                ))}
              </div>
            </section>
          );
        })}

        <!-- Comunidad de WhatsApp -->
        <div class="p-8 sm:p-12 bg-deep/90 border border-gold/30 rounded-sm text-center reveal shadow-2xl relative overflow-hidden">
          <div class="inline-flex items-center gap-2 px-3.5 py-1 bg-gold/10 text-gold text-xs font-body uppercase tracking-widest rounded-full mb-5 border border-gold/30">
            <span>Comunidad abierta</span>
            <span class="w-1.5 h-1.5 rounded-full bg-gold animate-pulse"></span>
            <span>+70 personas de todo el mundo</span>
          </div>
          <h3 class="font-display text-2xl sm:text-3xl lg:text-4xl text-gold font-light mb-4 tracking-wide">
            Comunidad de WhatsApp
          </h3>
          <p class="font-body font-light text-parchment/85 text-base sm:text-lg max-w-2xl mx-auto mb-4 leading-relaxed">
            Un espacio donde comparto pequeñas reflexiones cotidianas alrededor de los vínculos en general, los talleres que se van ofreciendo y los contenidos del canal de YouTube.
          </p>
          <p class="font-body font-light text-parchment/60 text-sm max-w-xl mx-auto mb-8">
            Sumate para recibir las reflexiones y formar parte de este círculo internacional de intercambio y aprendizaje.
          </p>
          <div class="flex justify-center">
            <Button href="https://chat.whatsapp.com/L7jnhxhIvqb6QbwnFN1PJo" variant="primary" external>
              Ingresar a la comunidad de WhatsApp
            </Button>
          </div>
        </div>

        <!-- Llamado a seguir en redes -->
        <div class="p-8 sm:p-12 bg-deep/70 border border-gold/20 rounded-sm text-center reveal">
          <h3 class="font-display text-2xl sm:text-3xl text-gold font-light mb-3">
            Ampliá las lecturas y reflexiones en redes
          </h3>
          <p class="font-body font-light text-parchment/75 text-sm sm:text-base max-w-xl mx-auto mb-8 leading-relaxed">
            Comparto análisis simbólicos, audios y miradas cotidianas de forma semanal en mi perfil de Instagram y canal de YouTube.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <Button href="https://instagram.com/florencia.villeneuve" variant="primary" external>
              Instagram @florencia.villeneuve
            </Button>
            <Button href="https://www.youtube.com/@florencia.villeneuve" variant="primary" external>
              Canal de YouTube
            </Button>
          </div>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
