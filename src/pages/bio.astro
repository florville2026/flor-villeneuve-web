---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SectionTitle from '../components/ui/SectionTitle.astro';
import Button from '../components/ui/Button.astro';
import { bioData } from '../data/bio';
---

<BaseLayout
  title="Sobre mí | Florencia Villeneuve"
  description="Acompañamiento e investigación en la arquitectura viva de las relaciones. Conoce el recorrido, la mirada y el marco de trabajo de Florencia Villeneuve."
  keywords="Florencia Villeneuve, sobre mí, biografía, acompañamiento vincular, psicología jungiana, arte terapia, sistemas familiares, Un curso de milagros, Montevideo, Buenos Aires"
  canonical="/bio"
>
  <Header />
  <main class="bg-deep">
    <!-- Hero / Presentación -->
    <section class="section-padding pt-32 border-b border-gold/15">
      <div class="container-padding max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <SectionTitle
            title={bioData.title}
            subtitle={bioData.subtitle}
          />
        </div>

        <div class="flex justify-center mb-12">
          <img
            src="/img/flor-sobre-mi.jpg"
            alt="Florencia Villeneuve"
            class="aspect-square max-w-xs sm:max-w-sm w-full object-cover rounded-sm border border-gold/25 shadow-2xl reveal"
          />
        </div>

        <!-- Cita Inspiracional -->
        <blockquote class="border-l-2 border-gold/50 pl-6 sm:pl-8 py-4 my-10 bg-night/80 rounded-r-sm max-w-2xl mx-auto reveal">
          <p class="font-display text-2xl sm:text-3xl text-gold/90 italic leading-relaxed">
            "{bioData.quote.text}"
          </p>
          <footer class="mt-2 text-xs sm:text-sm font-body font-light text-parchment/60 not-italic tracking-wide">
            — {bioData.quote.author}
          </footer>
        </blockquote>
      </div>
    </section>

    <!-- Contenido y Secciones Biográficas -->
    <section class="section-padding bg-night">
      <div class="container-padding max-w-3xl mx-auto space-y-16">
        {bioData.sections.map((sec) => (
          <article class="space-y-6 reveal">
            <h2 class="font-display text-2xl sm:text-3xl text-gold font-light tracking-wide leading-snug border-b border-gold/15 pb-3">
              {sec.title}
            </h2>
            <div class="space-y-4 font-body font-light text-parchment/85 text-base sm:text-lg leading-relaxed text-justify sm:text-left">
              {sec.paragraphs.map((p) => (
                <p>{p}</p>
              ))}
            </div>
          </article>
        ))}

        <!-- Marco de Trabajo Metodológico -->
        <section class="bg-deep/80 border border-gold/25 rounded-sm p-8 sm:p-12 reveal">
          <h2 class="font-display text-2xl sm:text-3xl text-gold font-light mb-4 leading-snug">
            {bioData.frameworkTitle}
          </h2>
          <p class="font-body font-light text-parchment/80 text-sm sm:text-base leading-relaxed mb-8">
            {bioData.frameworkLead}
          </p>
          <div class="space-y-5">
            {bioData.frameworkItems.map((item) => (
              <div class="pl-4 border-l-2 border-gold/40">
                <h3 class="font-heading text-lg sm:text-xl text-gold font-normal mb-1">
                  {item.title}
                </h3>
                <p class="font-body font-light text-parchment/75 text-sm sm:text-base leading-relaxed">
                  {item.description}
                </p>
              </div>
            ))}
          </div>
        </section>

        <!-- Cierre y Servicio -->
        <article class="space-y-6 reveal">
          <h2 class="font-display text-2xl sm:text-3xl text-gold font-light tracking-wide leading-snug border-b border-gold/15 pb-3">
            {bioData.closingTitle}
          </h2>
          <div class="space-y-4 font-body font-light text-parchment/85 text-base sm:text-lg leading-relaxed text-justify sm:text-left">
            {bioData.closingParagraphs.map((p) => (
              <p>{p}</p>
            ))}
          </div>
        </article>

        <!-- Bloque de Enlace a Servicios -->
        <div class="mt-16 p-8 sm:p-12 bg-deep border border-gold/30 rounded-sm text-center reveal">
          <span class="inline-block px-3 py-1 bg-gold/10 text-gold text-xs font-body uppercase tracking-widest rounded-full mb-4 border border-gold/20">
            Acompañamiento Vincular
          </span>
          <h3 class="font-display text-2xl sm:text-3xl text-gold font-light mb-4">
            Explorá las modalidades de trabajo y sesiones
          </h3>
          <p class="font-body font-light text-parchment/75 text-sm sm:text-base max-w-xl mx-auto mb-8 leading-relaxed">
            Te invito a conocer las sesiones de Pareja, Crianza y Proceso Vincular Individual diseñadas para destrabar patrones y traer claridad a tus relaciones.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
            <Button href="/servicios" variant="primary">
              Ver Servicios y Sesiones
            </Button>
            <Button href="https://wa.me/59892497675?text=Hola%20Flor,%20le%C3%AD%20tu%20historia%20en%20Sobre%20M%C3%AD%20y%20me%20gustar%C3%ADa%20hacerte%20una%20consulta." variant="outline" external>
              Consultar por WhatsApp
            </Button>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>