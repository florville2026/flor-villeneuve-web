---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import BlogArticleCard from '../../components/ui/BlogArticleCard.astro';
import Button from '../../components/ui/Button.astro';
import { blogPosts } from '../../data/blog';
import type { BlogPost } from '../../types';

export function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const otherPosts = blogPosts.filter((p) => p.slug !== post.slug);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.excerpt,
  author: {
    '@type': 'Person',
    name: 'Florencia Villeneuve',
    url: 'https://florenciavilleneuve.com',
  },
  publisher: {
    '@type': 'Person',
    name: 'Florencia Villeneuve',
  },
  keywords: post.tags.join(', '),
  mainEntityOfPage: `https://florenciavilleneuve.com/blog/${post.slug}`,
};
---

<BaseLayout
  title={`${post.title} — Blog`}
  description={post.excerpt}
  keywords={post.tags.join(', ')}
  canonical={`/blog/${post.slug}`}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />

  <Header />
  <main class="pt-24 min-h-screen bg-night">
    <!-- Migas de pan / Volver -->
    <div class="container-padding max-w-4xl mx-auto pt-8 pb-4">
      <a
        href={`/blog#${post.category}`}
        class="inline-flex items-center gap-2 text-xs font-body uppercase tracking-widest text-gold/80 hover:text-gold transition-colors duration-200"
      >
        <span>← Volver a Blog • {post.categoryLabel}</span>
      </a>
    </div>

    <!-- Contenido del Artículo -->
    <section class="container-padding max-w-4xl mx-auto pb-16">
      <BlogArticleCard post={post} standalone={true} />

      <!-- Invitación a la Comunidad de WhatsApp -->
      <div class="mt-14 p-8 sm:p-10 bg-deep/80 border border-gold/25 rounded-sm text-center">
        <span class="inline-block px-3 py-1 bg-gold/10 text-gold text-xs font-body uppercase tracking-widest rounded-full mb-4 border border-gold/25">
          Comunidad de más de 70 personas de todo el mundo
        </span>
        <h3 class="font-display text-2xl sm:text-3xl text-gold font-light mb-3">
          ¿Querés recibir más reflexiones sobre vínculos?
        </h3>
        <p class="font-body font-light text-parchment/80 text-sm sm:text-base max-w-xl mx-auto mb-6 leading-relaxed">
          En mi comunidad de WhatsApp comparto pequeñas reflexiones cotidianas alrededor de los vínculos, los talleres que voy ofreciendo y los contenidos del canal de YouTube.
        </p>
        <div class="flex justify-center">
          <Button href="https://chat.whatsapp.com/L7jnhxhIvqb6QbwnFN1PJo" variant="outline" external>
            Sumarme a la comunidad de WhatsApp
          </Button>
        </div>
      </div>

      <!-- Otras lecturas recomendadas -->
      {otherPosts.length > 0 && (
        <div class="mt-16 pt-12 border-t border-gold/20">
          <h3 class="font-display text-2xl text-gold font-light mb-6">
            Otras reflexiones vinculares
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {otherPosts.map((item) => (
              <a
                href={`/blog/${item.slug}`}
                class="p-6 bg-deep/70 border border-gold/15 rounded-sm hover:border-gold/40 hover:bg-deep transition-all duration-300 flex flex-col justify-between group"
              >
                <div>
                  <span class="text-xs uppercase tracking-widest text-gold/60 font-body block mb-2">
                    {item.categoryLabel}
                  </span>
                  <h4 class="font-heading text-lg text-parchment group-hover:text-gold transition-colors duration-200 font-light leading-snug">
                    {item.title}
                  </h4>
                </div>
                <div class="mt-4 pt-3 border-t border-gold/10 text-xs text-gold/70 font-body flex items-center justify-between">
                  <span>{item.readingTime}</span>
                  <span class="group-hover:translate-x-1 transition-transform duration-200">Leer →</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </section>
  </main>
  <Footer />
</BaseLayout>
