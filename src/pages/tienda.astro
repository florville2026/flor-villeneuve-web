---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Button from '../components/ui/Button.astro';

const whatsappUrl = 'https://wa.me/59892497675';

const upcomingItems = [
  {
    category: 'Material Editorial',
    title: 'Guías y Cuadernos Simbólicos',
    desc: 'Publicaciones digitales e impresas diseñadas para el trabajo personal, la exploración de arquetipos y el registro de procesos internos.',
  },
  {
    category: 'Herramientas',
    title: 'Oráculos y Barajas Temáticas',
    desc: 'Objetos rituales y mazos de inspiración visual para habilitar el diálogo con el inconsciente y la sincronía.',
  },
  {
    category: 'Recursos Digitales',
    title: 'Clases Magistrales y Audios',
    desc: 'Meditaciones guiadas, mapas de tránsitos y cápsulas de estudio para profundizar a tu propio ritmo.',
  },
];
---

<BaseLayout
  title="Tienda"
  description="Tienda de Florencia Villeneuve. Próximamente: oráculos, guías simbólicas, libros y recursos de autoconocimiento y arte."
  keywords="tienda esotérica, oráculos simbólicos, libros de astrología, guías de autoconocimiento, Florencia Villeneuve, Montevideo, Uruguay"
  canonical="/tienda"
>
  <Header />
  <main class="pt-24 min-h-[80vh] flex flex-col justify-between">
    <!-- Hero con Badge Próximamente -->
    <section class="section-padding bg-deep border-b border-gold/10">
      <div class="container-padding max-w-3xl mx-auto text-center">
        <span class="inline-block px-3 py-1 bg-gold/15 text-gold text-xs font-body uppercase tracking-widest rounded-full mb-6 border border-gold/30">
          Próximamente
        </span>
        <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-gold font-light mb-6 tracking-wide">
          Tienda Simbólica
        </h1>
        <p class="font-body font-light text-parchment/80 text-lg md:text-xl leading-relaxed mb-8">
          Un espacio en preparación dedicado a herramientas, publicaciones y objetos creados para acompañar tus prácticas cotidianas y tu camino de autodescubrimiento.
        </p>
        <div class="inline-block p-1 border-b border-gold/30">
          <p class="font-heading italic text-sm text-gold/80">
            Estamos seleccionando y diseñando cada pieza con cuidado artesanal y sentido místico.
          </p>
        </div>
      </div>
    </section>

    <!-- Vista previa de categorías -->
    <section class="section-padding bg-night flex-1">
      <div class="container-padding max-w-5xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {upcomingItems.map((item) => (
            <div class="p-8 bg-deep/80 border border-gold/15 rounded-sm flex flex-col justify-between">
              <div>
                <span class="font-body text-xs text-gold/60 uppercase tracking-wider block mb-2">
                  {item.category}
                </span>
                <h3 class="font-heading text-xl text-gold font-normal mb-3">
                  {item.title}
                </h3>
                <p class="font-body font-light text-parchment/70 text-sm leading-relaxed">
                  {item.desc}
                </p>
              </div>
              <div class="mt-6 pt-4 border-t border-gold/10 text-xs text-parchment/50 font-body">
                Disponible pronto
              </div>
            </div>
          ))}
        </div>

        <div class="mt-16 text-center max-w-xl mx-auto">
          <h4 class="font-display text-2xl text-gold mb-3 font-light">¿Buscás algún material o lectura específica?</h4>
          <p class="font-body font-light text-parchment/70 text-sm mb-6 leading-relaxed">
            Podés escribir directamente para consultar por recomendaciones bibliográficas o recursos personalizados.
          </p>
          <Button href={whatsappUrl} variant="primary" external>
            Consultar por WhatsApp
          </Button>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
