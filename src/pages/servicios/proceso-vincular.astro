---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import SectionTitle from '../../components/ui/SectionTitle.astro';
import Button from '../../components/ui/Button.astro';
import { vincularServices } from '../../data/services';

const service = vincularServices.find((s) => s.id === 'proceso-vincular')!;
const whatsappUrl = `https://wa.me/59892497675?text=${encodeURIComponent(service.whatsappMessage)}`;
---

<BaseLayout
  title={service.title}
  description="Proceso vincular individual con Florencia Villeneuve. Un trabajo en profundidad sobre tu matriz relacional para comprender tus patrones de elección, sanar tu historia familiar y transformar la manera en que te entregas al amor."
  keywords="proceso vincular individual, estilos de apego, lealtades familiares, límites personales, rupturas de pareja, autoestima vincular, Florencia Villeneuve, Montevideo, Buenos Aires"
  canonical="/servicios/proceso-vincular"
>
  <Header />
  <main class="pt-24">
    <!-- Hero -->
    <section class="section-padding bg-deep border-b border-gold/10">
      <div class="container-padding max-w-4xl mx-auto text-center">
        <a href="/servicios" class="font-body text-xs uppercase tracking-widest text-gold/80 hover:text-gold mb-3 inline-block">
          ← Volver a Servicios
        </a>
        <span class="font-display text-gold/60 text-sm tracking-widest block mb-2">
          {service.subtitle}
        </span>
        <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-gold font-light mb-6 tracking-wide">
          {service.title}
        </h1>
        {service.introParagraphs && service.introParagraphs.length > 0 ? (
          <div class="space-y-4 max-w-3xl mx-auto mb-8 text-center">
            {service.introParagraphs.map((paragraph, pIdx) => (
              <p
                class:list={[
                  pIdx === 0
                    ? 'font-body font-normal text-goldLight text-lg md:text-xl leading-relaxed'
                    : 'font-body font-light text-parchment/80 text-base md:text-lg leading-relaxed',
                ]}
              >
                {paragraph}
              </p>
            ))}
          </div>
        ) : (
          <p class="font-body font-light text-parchment/80 text-lg md:text-xl leading-relaxed max-w-2xl mx-auto mb-6">
            {service.description}
          </p>
        )}
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-gold/10 border border-gold/20 rounded-full text-gold text-xs font-body tracking-wide">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Duración: {service.duration}</span>
        </div>
      </div>
    </section>

    <!-- Temáticas y áreas -->
    <section class="section-padding bg-night">
      <div class="container-padding max-w-4xl mx-auto">
        <SectionTitle
          title="Temáticas y áreas concretas que abordamos"
          subtitle="Comprender tus patrones afectivos y habitar el amor desde tu verdad interna."
        />

        <div class="space-y-4 mt-10">
          {service.topics.map((t) => (
            <div class="p-6 sm:p-7 bg-deep/60 border border-gold/15 rounded-sm reveal">
              <h3 class="font-heading text-gold text-xl sm:text-2xl font-light mb-2">{t.title}</h3>
              <p class="font-body font-light text-parchment/80 text-base sm:text-lg leading-relaxed">{t.desc}</p>
            </div>
          ))}
        </div>

        <div class="mt-12 p-8 bg-deep border border-gold/20 rounded-sm reveal">
          <p class="font-body font-light text-parchment/85 text-base sm:text-lg leading-relaxed italic">
            <strong class="text-gold">Nota importante:</strong> {service.note}
          </p>
        </div>

        <!-- CTA -->
        <div class="mt-12 text-center reveal">
          <p class="font-body font-light text-parchment/80 mb-6 text-base sm:text-lg">
            Las sesiones se realizan de forma online mediante videollamada para Uruguay, Argentina y el exterior.
          </p>
          <Button href={whatsappUrl} variant="primary" external>
            Reservar lugar para tu primera sesión
          </Button>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
