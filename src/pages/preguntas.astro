---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SectionTitle from '../components/ui/SectionTitle.astro';
import { faqCategories } from '../data/faqs';

const whatsappUrl = 'https://wa.me/59892497675';
---

<BaseLayout
  title="Preguntas Frecuentes"
  description="Preguntas frecuentes por servicio: sesiones de pareja, crianza y familia, proceso vincular individual y dinámica de encuentros con Florencia Villeneuve."
  keywords="preguntas frecuentes, FAQ, sesión de pareja, crianza consciente, vínculos familiares, proceso vincular individual, psicología junguiana, simbología, astrología, dinámicas vinculares, Florencia Villeneuve"
  canonical="/preguntas"
>
  <Header />
  <main>
    <section class="section-padding bg-deep pt-32">
      <div class="container-padding">
        <SectionTitle
          title="Preguntas Frecuentes por Servicio"
          subtitle="Claridad sobre el encuadre, la dinámica de trabajo y cada espacio de encuentro"
        />

        <div class="max-w-4xl mx-auto space-y-16">
          {faqCategories.map((category, index) => (
            <section id={category.id} class="space-y-6">
              <div class="flex items-center gap-3 border-b border-gold/20 pb-4 reveal">
                <span class="text-2xl" aria-hidden="true">{category.icon}</span>
                <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
                  <h2 class="font-heading text-2xl md:text-3xl text-goldLight font-normal">
                    {category.title}
                  </h2>
                  <span class="text-xs font-body tracking-[0.2em] uppercase text-gold/80 border border-gold/30 px-2.5 py-0.5 rounded-full">
                    {category.badge}
                  </span>
                </div>
              </div>

              <div class="space-y-6">
                {category.items.map((item) => (
                  <article class="p-6 md:p-8 border border-gold/15 rounded-sm bg-night/70 backdrop-blur-sm hover:border-gold/35 transition-colors duration-300 reveal">
                    <h3 class="font-heading font-normal text-gold text-lg md:text-xl mb-4 leading-snug">
                      {item.question}
                    </h3>
                    <div class="space-y-3 font-body font-light text-parchment/80 leading-relaxed">
                      {item.paragraphs.map((paragraph) => (
                        <p>{paragraph}</p>
                      ))}
                      {item.bullets && item.bullets.length > 0 && (
                        <ul class="space-y-2.5 my-3 pl-1">
                          {item.bullets.map((bullet) => (
                            <li class="flex items-start gap-3 text-parchment/90">
                              <span class="text-gold font-normal select-none leading-relaxed">—</span>
                              <span>{bullet}</span>
                            </li>
                          ))}
                        </ul>
                      )}
                      {item.closingParagraph && (
                        <p class="pt-1">{item.closingParagraph}</p>
                      )}
                    </div>
                  </article>
                ))}
              </div>

              {index < faqCategories.length - 1 && (
                <div class="pt-6" />
              )}
            </section>
          ))}

          <div class="reveal border-t border-gold/20 pt-12 mt-12 text-center max-w-2xl mx-auto">
            <h3 class="font-display text-2xl md:text-3xl text-gold mb-4 font-normal">
              ¿Tenés alguna otra duda o consulta?
            </h3>
            <p class="font-body font-light text-parchment/75 mb-8 leading-relaxed">
              Podés escribirme directamente por WhatsApp para conversar sobre tu situación y ver qué espacio es el más adecuado para comenzar.
            </p>
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="cta-button inline-flex items-center gap-2"
            >
              Consultar por WhatsApp
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>