---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import Identification from '../components/sections/Identification.astro';
import About from '../components/sections/About.astro';
import Contact from '../components/sections/Contact.astro';
import Testimonials from '../components/sections/Testimonials.astro';

---

<BaseLayout
  title="Inicio"
  description="Florencia Villeneuve — Acompañamiento vincular, simbología y psicología. Sesión de pareja, crianza o familia y proceso vincular individual. Consultas online para Uruguay, Argentina e internacional."
  keywords="Florencia Villeneuve, acompañamiento vincular, sesión de pareja, crianza consciente, proceso vincular individual, astrología, psicología simbólica, transformación personal, autoconocimiento, Montevideo, Uruguay, Buenos Aires, Argentina"
>
  <Header />
  <main>
    <Hero />
    <Identification />
    <About />
    <Testimonials />
    <Contact />
  </main>
  <Footer />
</BaseLayout>

<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Florencia Villeneuve",
  "url": "https://florenciavilleneuve.com",
  "jobTitle": "Mentora",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Montevideo",
    "addressCountry": "UY"
  },
  "areaServed": [
    {
      "@type": "Country",
      "name": "Uruguay"
    },
    {
      "@type": "Country",
      "name": "Argentina"
    }
  ],
  "sameAs": [
    "https://instagram.com/florencia.villeneuve"
  ]
}
</script>