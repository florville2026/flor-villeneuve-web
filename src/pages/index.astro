---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import Identification from '../components/sections/Identification.astro';
import About from '../components/sections/About.astro';
import Contact from '../components/sections/Contact.astro';
import Testimonials from '../components/sections/Testimonials.astro';

---

<BaseLayout
  title="Inicio"
  description="Florencia Villeneuve — Parejas, crianza y vínculos. Sesión de pareja, dinámica familiar y proceso vincular individual. Acompañamiento online para Uruguay, Argentina e internacional."
  keywords="Florencia Villeneuve, parejas, crianza, vinculos, acompañamiento vincular, sesion de pareja, crianza consciente, dinamica familiar, proceso vincular individual, psicología vincular, autoconocimiento, Uruguay, Argentina"
>
  <Header />
  <main>
    <Hero />
    <Identification />
    <About />
    <Testimonials />
    <Contact />
  </main>
  <Footer />
</BaseLayout>

<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Florencia Villeneuve",
  "url": "https://florenciavilleneuve.com",
  "jobTitle": "Acompañamiento en Parejas, Crianza y Vínculos",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Montevideo",
    "addressCountry": "UY"
  },
  "areaServed": [
    {
      "@type": "Country",
      "name": "Uruguay"
    },
    {
      "@type": "Country",
      "name": "Argentina"
    }
  ],
  "sameAs": [
    "https://instagram.com/florencia.villeneuve"
  ]
}
</script>