---
import type { BlogPost } from '../../types';
import Button from './Button.astro';

interface Props {
  post: BlogPost;
  standalone?: boolean;
}

const { post, standalone = false } = Astro.props;
const postUrl = `/blog/${post.slug}`;
const summaryParagraph = post.sections[0]?.paragraphs[0] ?? post.excerpt;
---

<article id={post.slug} class="bg-deep/60 border border-gold/20 rounded-sm p-6 sm:p-10 md:p-12 transition-all duration-300 hover:border-gold/40 reveal">
  <!-- Encabezado y Metadatos -->
  <header class="mb-6">
    <div class="flex flex-wrap items-center justify-between gap-3 text-xs sm:text-sm font-body tracking-wider uppercase mb-4 text-gold/70">
      <div class="flex items-center gap-2">
        <span class="px-3.5 py-1 bg-gold/10 border border-gold/30 rounded-full text-gold font-medium">
          {post.categoryLabel}
        </span>
        <span class="text-parchment/40">•</span>
        <span class="text-parchment/70">{post.readingTime}</span>
      </div>
    </div>

    {standalone ? (
      <h1 class="font-display text-3xl sm:text-5xl md:text-6xl text-gold font-light leading-snug tracking-wide mb-6">
        {post.title}
      </h1>
    ) : (
      <h2 class="font-display text-2xl sm:text-4xl md:text-5xl text-gold font-light leading-snug tracking-wide mb-6">
        <a href={postUrl} class="hover:text-goldLight transition-colors duration-200">
          {post.title}
        </a>
      </h2>
    )}

    <!-- Tags -->
    <div class="flex flex-wrap gap-2 pt-2 border-t border-gold/10">
      {post.tags.map((tag) => (
        <span class="text-xs sm:text-sm font-body text-parchment/70 bg-night/80 px-3 py-1 rounded-xs border border-gold/10">
          #{tag}
        </span>
      ))}
    </div>
  </header>

  <!-- Cuerpo del Artículo -->
  {standalone ? (
    <div class="space-y-8 font-body font-light text-parchment/90 text-lg sm:text-xl lg:text-2xl leading-relaxed">
      {post.sections.map((section) => (
        <div class="space-y-5">
          {section.title && (
            <h3 class="font-heading text-goldLight text-2xl sm:text-3xl lg:text-4xl font-normal pt-4 tracking-wide">
              {section.title}
            </h3>
          )}
          {section.paragraphs.map((p) => {
            // Destacar si inicia con subtítulos tipo "El repliegue del sostén:" o "La trampa de la sobrecompensación:"
            const colonIndex = p.indexOf(':');
            const isLeadTitle = colonIndex > 0 && colonIndex < 55 && !p.startsWith('Desde') && p.slice(colonIndex + 1).trim().length > 0;
            if (isLeadTitle) {
              const lead = p.slice(0, colonIndex);
              const rest = p.slice(colonIndex + 1);
              return (
                <p class="pl-4 border-l-2 border-gold/40 text-parchment/95">
                  <strong class="font-heading text-gold font-normal block sm:inline text-xl sm:text-2xl">{lead}:</strong>
                  <span class="text-parchment/85">{rest}</span>
                </p>
              );
            }
            return <p>{p}</p>;
          })}
        </div>
      ))}
    </div>
  ) : (
    <div class="space-y-6 font-body font-light text-parchment/90 text-lg sm:text-xl lg:text-2xl leading-relaxed">
      <p>{summaryParagraph}</p>
      <div class="pt-2">
        <a
          href={postUrl}
          class="inline-flex items-center gap-2 text-gold hover:text-goldLight font-body font-medium text-lg sm:text-xl transition-all duration-200 group"
        >
          <span>Leer más</span>
          <span class="transition-transform duration-200 group-hover:translate-x-1.5 text-xl">→</span>
        </a>
      </div>
    </div>
  )}

  <!-- Caja de Llamada a la Acción de Agenda (solo en lectura completa) -->
  {standalone && (
    <footer class="mt-12 pt-8 border-t border-gold/20">
      <div class="bg-night/90 border border-gold/30 rounded-sm p-6 sm:p-8">
        <div class="flex items-center gap-2 text-gold text-xs sm:text-sm uppercase tracking-widest font-body mb-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span>Espacio de Consulta y Acompañamiento</span>
        </div>
        <h4 class="font-heading text-2xl sm:text-3xl text-gold font-normal mb-2">
          {post.relatedService.title}
        </h4>
        <p class="font-body font-light text-parchment/80 text-base sm:text-lg leading-relaxed mb-6">
          {post.relatedService.description}
        </p>
        <div class="flex justify-center items-center">
          <Button href={post.relatedService.slug} variant="primary">
            {post.relatedService.ctaText}
          </Button>
        </div>
      </div>
    </footer>
  )}
</article>
