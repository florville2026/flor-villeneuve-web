---
interface Props {
  href: string;
  variant?: 'primary' | 'outline';
  children?: string;
  external?: boolean;
  class?: string;
}

const { href, variant = 'primary', children, external = false, class: className } = Astro.props;
const target = external ? '_blank' : undefined;
const rel = external ? 'noopener noreferrer' : undefined;
---

<a
  href={href}
  target={target}
  rel={rel}
  class:list={[
    variant === 'primary' ? 'cta-button' : 'cta-button-outline',
    className,
  ]}
>
  <slot>{children}</slot>
</a>