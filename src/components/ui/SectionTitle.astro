---
interface Props {
  title: string;
  subtitle?: string;
  light?: boolean;
}

const { title, subtitle, light = false } = Astro.props;
---

<div class="text-center mb-16 reveal">
  <h2 class:list={[
    'font-display font-semibold tracking-wide',
    light ? 'text-ink' : 'text-parchment',
    'text-4xl sm:text-5xl lg:text-6xl',
  ]}>
    {title}
  </h2>
  {subtitle && (
    <p class:list={[
      'font-body font-light mt-4 sm:mt-5 text-lg sm:text-xl lg:text-2xl max-w-3xl mx-auto leading-relaxed',
      light ? 'text-earth/80' : 'text-parchment/75',
    ]}>
      {subtitle}
    </p>
  )}
  <div class="flex justify-center mt-6">
    <span class="block w-16 h-px bg-gold/40"></span>
  </div>
</div>