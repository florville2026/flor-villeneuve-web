---
import SectionTitle from '../ui/SectionTitle.astro';
import Button from '../ui/Button.astro';

interface QuestionItem {
  number: string;
  text: string;
}

const questions: QuestionItem[] = [
  {
    number: '01',
    text: '¿Sientes que en tu pareja o familia siempre tropezáis con la misma piedra?',
  },
  {
    number: '02',
    text: '¿Te descubres actuando más como "padre o madre" de tu compañero/a que como su pareja?',
  },
  {
    number: '03',
    text: '¿Os cuesta poneros de acuerdo en los límites de la crianza y sientes que eso desgasta la relación?',
  },
  {
    number: '04',
    text: '¿Te preguntas por qué, a pesar del amor, no lográis destrabar los problemas de comunicación?',
  },
  {
    number: '05',
    text: '¿Te gustaría entender qué pactos invisibles e historias familiares condicionan cómo te relacionas hoy?',
  },
];
---

<section class="section-padding bg-night relative overflow-hidden border-t border-b border-gold/10">
  <div class="container-padding relative z-10">
    <SectionTitle
      title="Reconocer los patrones que se repiten en tus vínculos es el primer paso para transformarlos."
    />

    <div class="border-t border-b border-gold/15 py-10 md:py-14 my-10 md:my-12">
      <div class="flex flex-col space-y-4 sm:space-y-5 max-w-5xl xl:max-w-6xl mx-auto">
        {questions.map((item) => (
          <article
            class="group relative py-4 sm:py-5 px-6 sm:px-8 rounded-sm bg-deep/60 border border-gold/15 transition-all duration-300 hover:border-gold/40 hover:bg-deep/90 hover:-translate-y-0.5 reveal w-full border-l-2 border-l-gold/40"
          >
            <div class="flex items-center gap-4 sm:gap-6">
              <span class="inline-flex items-center justify-center w-10 h-10 sm:w-12 sm:h-12 rounded-full border border-gold/40 text-gold text-base sm:text-lg font-display font-medium shrink-0 group-hover:border-gold group-hover:bg-gold/15 transition-all duration-300">
                {item.number}
              </span>
              <p class="font-heading font-light text-parchment text-lg sm:text-xl md:text-[1.35rem] lg:text-[1.45rem] leading-snug group-hover:text-goldLight transition-colors duration-300">
                “{item.text}”
              </p>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="text-center mt-12 md:mt-16 reveal reveal-delay-2">
      <p class="font-display font-semibold text-parchment text-3xl sm:text-4xl md:text-5xl tracking-wide max-w-4xl mx-auto leading-tight md:leading-snug">
        Detrás de cada tensión o malentendido no hay una falla personal, sino historias y dinámicas que necesitan ser vistas y comprendidas.
      </p>
      <div class="mt-8 md:mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button
          href="/servicios"
          variant="primary"
          class="px-10 py-3.5 sm:py-4 text-base sm:text-lg font-medium shadow-md shadow-gold/15"
        >
          Agendá tu primera sesión
        </Button>
      </div>
    </div>
  </div>
</section>
