---
import SectionTitle from '../ui/SectionTitle.astro';

interface Props {
  testimonials?: string[];
  title?: string;
  subtitle?: string;
  class?: string;
}

const { 
  testimonials = [
    "Pasaron muchas cosas internamente y entre ellas fue un despertar... Despertarme a darme cuenta que me estaba abandonando como persona. Y parte de eso tuvo que ver los encuentros contigo. Ahora estoy en ese proceso de reencuentro... de cuidado... de valoración de lo que soy y de como me quiero sentir. Fue tan grande el cambio que tomé decisiones en mi vida personal... Tomé decisiones que me dolieron pero ahora me estoy sintiendo mejor y segura del camino.",
    "La verdad me sorprendió como pudiste captar la situación solo con lo que yo te pude transmitir, y esa situación que describiste es tal cual la realidad. Te agradezco por las herramientas que me brindaste y me abriste la cabeza a ver y darme cuenta de cosas que quizás estaba negada a ver. Sin duda los encuentros contigo me sirvieron para varios aspectos de mi vida.",
    "El contenido de la sesión fue muy nutrido y me permitió ver las cosas de una manera más amable. Siempre se necesitan otras linternas y fuiste esa luz que necesitaba en el momento. Te estoy profundamente agradecida.",
    "Yo estoy plenamente agradecida por la mentoría porque me pareció una experiencia enriquecedora y movilizante. Tu capacidad para acompañar es muy rica y tu perspectiva desde otras miradas como lo espiritual, la filosofía y la astrología me pareció fascinante.",
    "Ha sido una figura clave en nuestra evolución personal y de pareja durante estos últimos dos años. Su honrada y honesta colaboración, guiada por un profundo conocimiento en el arte del crecimiento personal, ha sido de un valor incalculable para nosotros.",
  ],
  title = "Voces",
  subtitle = "Testimonios de personas, parejas y familias.",
  class: className
} = Astro.props;
---

<section class={`section-padding bg-deep testimonial-section ${className || ''}`}>
  <div class="container-padding">
    <SectionTitle
      title={title}
      subtitle={subtitle}
    />
    <div class="max-w-4xl mx-auto">
      <div class="overflow-hidden testimonial-track-container">
        <div class="flex transition-transform duration-500 ease-out testimonial-inner">
          {testimonials.map((t) => (
            <div class="testimonial-slide w-full flex-shrink-0 px-4">
              <blockquote class="text-center max-w-3xl mx-auto">
                <p class="font-display text-2xl sm:text-3xl md:text-4xl text-parchment/90 leading-relaxed italic mb-8">
                  "{t}"
                </p>
              </blockquote>
            </div>
          ))}
        </div>
      </div>
      <div class="flex justify-center gap-3 mt-10">
        {testimonials.map((_, i) => (
          <button
            class="testimonial-dot w-2.5 h-2.5 rounded-full bg-gold/30 transition-colors duration-300"
            data-index={i}
            aria-label={`Ver testimonio ${i + 1}`}
          />
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  function initTestimonials() {
    const sections = document.querySelectorAll('.testimonial-section');
    
    sections.forEach(section => {
      // Avoid double initialization
      if ((section as any)._initialized) return;
      (section as any)._initialized = true;

      const track = section.querySelector('.testimonial-inner') as HTMLElement;
      const dots = section.querySelectorAll('.testimonial-dot');
      let currentIndex = 0;
      let interval: number;

      if (!track || dots.length === 0) return;

      function showTestimonial(index: number) {
        if (!track) return;
        track.style.transform = `translateX(-${index * 100}%)`;
        dots.forEach((dot, i) => {
          if (i === index) {
            dot.classList.remove('bg-gold/30');
            dot.classList.add('bg-gold');
          } else {
            dot.classList.remove('bg-gold');
            dot.classList.add('bg-gold/30');
          }
        });
        currentIndex = index;
      }

      function next() {
        const nextIndex = (currentIndex + 1) % dots.length;
        showTestimonial(nextIndex);
      }

      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          clearInterval(interval);
          showTestimonial(i);
          interval = setInterval(next, 5000) as unknown as number;
        });
      });

      showTestimonial(0);
      interval = setInterval(next, 5000) as unknown as number;
    });
  }

  // Init on load
  initTestimonials();
</script>