---
import SectionTitle from '../ui/SectionTitle.astro';
import Button from '../ui/Button.astro';

const whatsappUrl = 'https://wa.me/59892497675';
const emailUrl = 'mailto:florencia.villeneuve@gmail.com';

interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = 'Contacto',
  subtitle = 'Escribime. Toda consulta se responde con calma y atención.',
} = Astro.props;
---

<section class="section-padding bg-night" id="contacto">
  <div class="container-padding">
    <SectionTitle title={title} subtitle={subtitle} />
    <div
      class="max-w-2xl mx-auto reveal bg-deep/60 border border-gold/15 p-8 sm:p-12 md:p-14 rounded-sm shadow-2xl text-center space-y-8"
    >
      <p class="font-body font-light text-parchment/90 text-lg sm:text-xl md:text-2xl leading-relaxed">
        Las consultas y coordinaciones de sesiones se hacen directamente por WhatsApp o vía correo electrónico.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-5">
        <Button href={whatsappUrl} variant="primary" external>
          Escribime por WhatsApp
        </Button>
        <Button href={emailUrl} variant="primary" external>
          Enviar un correo
        </Button>
      </div>
    </div>
  </div>
</section>
