---
import Nav from './Nav.astro';
import type { NavItem } from '../../types';
import { blogCategories, blogPosts } from '../../data/blog';

const blogNavChildren: NavItem[] = blogCategories.flatMap((cat) => {
  const posts = blogPosts.filter((p) => p.category === cat.id);
  if (posts.length === 1) {
    return [{ label: cat.label, href: `/blog/${posts[0].slug}` }];
  }
  if (posts.length > 1) {
    return posts.map((p) => ({
      label: p.title.length > 40 ? `${cat.label}: ${p.title.slice(0, 37)}...` : `${cat.label}: ${p.title}`,
      href: `/blog/${p.slug}`,
    }));
  }
  return [{ label: cat.label, href: `/blog#${cat.id}` }];
});

const navItems: NavItem[] = [
  { label: 'Inicio', href: '/' },
  {
    label: 'Servicios',
    href: '/servicios',
    children: [
      { label: 'Sesión de pareja', href: '/servicios/pareja' },
      { label: 'Sesión de crianza o familia', href: '/servicios/crianza-familia' },
      { label: 'Proceso vincular individual', href: '/servicios/proceso-vincular' },
    ],
  },
  { label: 'Tienda', href: '/tienda' },
  {
    label: 'Blog',
    href: '/blog',
    children: blogNavChildren,
  },
  { label: 'Sobre mí', href: '/bio' },
  { label: 'Preguntas frecuentes', href: '/preguntas' },
  { label: 'Contacto', href: '/#contacto' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-deep/95 backdrop-blur-sm border-b border-gold/10">
  <div class="container-padding flex items-center justify-between py-4">
    <a href="/" class="font-display text-xl sm:text-2xl lg:text-3xl font-semibold text-gold tracking-wide">
      Florencia Villeneuve
    </a>

    <button
      id="menu-toggle"
      class="md:hidden text-gold p-2 focus:outline-none flex-shrink-0"
      aria-label="Abrir menú"
      aria-expanded="false"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

    <Nav items={navItems} />
  </div>

  <nav id="mobile-menu" class="md:hidden hidden absolute top-full left-0 right-0 bg-night px-6 py-6 border-b border-gold/10 transition-all duration-300 ease-in-out opacity-0 -translate-y-2 invisible max-h-[85vh] overflow-y-auto">
    {navItems.map((item) => (
      item.children && item.children.length > 0 ? (
        <div class="py-2.5 border-b border-gold/10">
          <div class="flex items-center justify-between">
            <a
              href={item.href}
              class="font-body font-normal text-parchment tracking-wide transition-colors duration-300 hover:text-gold py-1 block text-lg"
            >
              {item.label}
            </a>
          </div>
          <div class="pl-4 mt-1.5 space-y-2.5 border-l border-gold/20">
            {item.children.map((subItem) => (
              <a
                href={subItem.href}
                class="font-body font-light text-parchment/80 tracking-wide transition-colors duration-300 hover:text-gold py-1.5 block text-base"
              >
                {subItem.label}
              </a>
            ))}
          </div>
        </div>
      ) : (
        <a
          href={item.href}
          class="font-body font-normal text-parchment/90 tracking-wide transition-colors duration-300 hover:text-gold py-3 block border-b border-gold/5 text-lg"
        >
          {item.label}
        </a>
      )
    ))}
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));

    if (menu) {
      if (menu.classList.contains('hidden')) {
        menu.classList.remove('hidden');
        requestAnimationFrame(() => {
          menu.classList.add('opacity-100', 'translate-y-0', 'visible');
          menu.classList.remove('opacity-0', '-translate-y-2', 'invisible');
        });
      } else {
        menu.classList.add('opacity-0', '-translate-y-2', 'invisible');
        menu.classList.remove('opacity-100', 'translate-y-0', 'visible');
        setTimeout(() => {
          menu.classList.add('hidden');
        }, 300);
      }
    }
  });

  // Cerrar menú al hacer clic en un link (útil para anchors en la misma página)
  const mobileLinks = menu?.querySelectorAll('a');
  mobileLinks?.forEach(link => {
    link.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      menu?.classList.add('opacity-0', '-translate-y-2', 'invisible');
      menu?.classList.remove('opacity-100', 'translate-y-0', 'visible');
      setTimeout(() => {
        menu?.classList.add('hidden');
      }, 300);
    });
  });
</script>