---
import type { NavItem } from "../../types";

const navItems: NavItem[] = [
  { label: "Inicio", href: "/" },
  { label: "Servicios", href: "/servicios" },
  { label: "Tienda", href: "/tienda" },
  { label: "Blog", href: "/blog" },
  { label: "Sobre mí", href: "/bio" },
  { label: "Preguntas frecuentes", href: "/preguntas" },
  { label: "Contacto", href: "/#contacto" },
];

const currentYear = new Date().getFullYear();
---

<footer class="bg-night border-t border-gold/10 section-padding">
  <div class="container-padding">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-12">
      <div>
        <a
          href="/"
          class="font-display text-2xl sm:text-3xl font-semibold text-gold tracking-wide"
        >
          Florencia Villeneuve
        </a>
        <p
          class="font-body font-light text-parchment/70 mt-3.5 text-base leading-relaxed"
        >
          Acompañamiento y Sesiones para Parejas, Crianza y Dinámicas Vinculares
        </p>
      </div>

      <div>
        <h3 class="font-heading text-lg sm:text-xl font-normal text-gold tracking-wide mb-5">
          Navegación
        </h3>
        <ul class="space-y-2.5">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="font-body font-light text-parchment/75 text-base hover:text-gold transition-colors duration-300"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="font-heading text-lg sm:text-xl font-normal text-gold tracking-wide mb-5">
          Conectá
        </h3>
        <ul class="space-y-3">
          <li>
            <a
              href="https://wa.me/59892497675"
              target="_blank"
              rel="noopener noreferrer"
              class="font-body font-light text-parchment/75 text-base hover:text-gold transition-colors duration-300"
            >
              WhatsApp
            </a>
          </li>
          <li>
            <a
              href="https://chat.whatsapp.com/L7jnhxhIvqb6QbwnFN1PJo"
              target="_blank"
              rel="noopener noreferrer"
              class="font-body font-light text-parchment/75 text-base hover:text-gold transition-colors duration-300"
            >
              Comunidad de WhatsApp
            </a>
          </li>
          <li>
            <a
              href="mailto:florencia.villeneuve@gmail.com"
              class="font-body font-light text-parchment/75 text-base hover:text-gold transition-colors duration-300"
            >
              florencia.villeneuve@gmail.com
            </a>
          </li>
          <li>
            <a
              href="https://www.instagram.com/florencia.villeneuve"
              target="_blank"
              rel="noopener noreferrer"
              class="font-body font-light text-parchment/75 text-base hover:text-gold transition-colors duration-300"
            >
              Instagram
            </a>
          </li>
          <li>
            <a
              href="https://www.youtube.com/@florencia.villeneuve"
              target="_blank"
              rel="noopener noreferrer"
              class="font-body font-light text-parchment/75 text-base hover:text-gold transition-colors duration-300"
            >
              YouTube
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="font-heading text-lg sm:text-xl font-normal text-gold tracking-wide mb-5">
          Términos
        </h3>
        <ul class="space-y-3">
          <li>
            <a
              href="/terminos-y-condiciones"
              class="font-body font-light text-parchment/75 text-base hover:text-gold transition-colors duration-300"
            >
              Términos y condiciones
            </a>
          </li>
          <li>
            <a
              href="/politica-de-cookies"
              class="font-body font-light text-parchment/75 text-base hover:text-gold transition-colors duration-300"
            >
              Política de Cookies
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="gold-divider mt-12 pt-8 flex flex-col md:flex-row justify-between items-center gap-4"
    >
      <p class="font-body font-light text-parchment/50 text-sm">
        &copy; {currentYear} Florencia Villeneuve. Todos los derechos reservados.
      </p>
      <p class="font-body font-light text-parchment/50 text-sm">
        Desarrollado por <a
          href="https://pablomgdev.xyz/"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-gold transition-colors duration-300">Pablo MG</a
        >
      </p>
    </div>
  </div>
</footer>
